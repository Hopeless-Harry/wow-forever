# Web server: keep loopback-only when using Cloudflare Tunnel.
HOST=127.0.0.1
PORT=3000

# Refresh and stale-data thresholds.
REFRESH_SECONDS=120
STALE_AFTER_SECONDS=600
CACHE_PATH=/var/lib/guild-ledger/cache.json
MEMBER_PATH=/var/lib/guild-ledger/members.json

# Google Sheet linked to the Form. Never put these values in public files.
GOOGLE_SHEET_ID=
GOOGLE_SHEET_RANGE=Form Responses 1!A:Z
GOOGLE_CLIENT_EMAIL=
# Keep this on one line; represent line breaks as literal \n characters.
GOOGLE_PRIVATE_KEY=

# Local preview only. Never enable this on the public Pi service.
USE_FIXTURE=false

# Per-IP requests per minute before the site answers 429 (0 turns the limit off).
RATE_LIMIT_PER_MINUTE=300
