{
  "name": "wow-forever-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "status": "tsx apps/cli/src/index.ts status",
    "install:addon": "tsx apps/cli/src/index.ts install",
    "restore:addon": "tsx apps/cli/src/index.ts restore",
    "mcp": "tsx apps/mcp-server/src/index.ts"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}

