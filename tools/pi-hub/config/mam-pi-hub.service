[Unit]
Description=Moms Against Magic Chronicles guild hub
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=mam-hub
Group=mam-hub
WorkingDirectory=/opt/mam-pi-hub/app
EnvironmentFile=-/etc/mam-pi-hub.env
Environment=NODE_ENV=production
Environment=DB_PATH=/var/lib/mam-pi-hub/pi-hub.sqlite
Environment=BACKUP_DIR=/var/lib/mam-pi-hub/backups
ExecStart=/usr/bin/node --experimental-sqlite src/server.js
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/mam-pi-hub
StateDirectory=mam-pi-hub

[Install]
WantedBy=multi-user.target
